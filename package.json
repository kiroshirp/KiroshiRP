{
  "name": "kiroshirp-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "admin": "node admin/local.mjs",
    "admin:test": "node --test admin/tests/*.test.mjs",
    "admin:deploy": "node scripts/deploy-admin.mjs",
    "admin:check": "wrangler deploy --dry-run --outdir .admin-build",
    "admin:publish-source": "node scripts/publish-admin-source.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/rajdhani": "^5.2.0",
    "@fontsource/share-tech-mono": "^5.2.0",
    "astro": "^7.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.4.0",
    "typescript": "^5.9.0",
    "wrangler": "4.151.1"
  }
}
