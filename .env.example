# Archivo privado. Copiar a .env y completar SOLO en el ordenador/servidor privado.
# No utilizar nombres PUBLIC_ ni VITE_ para estas credenciales.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Solo para publicar el administrador en Cloudflare. Nunca se envían al navegador.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Acceso a Discord: configurar en la aplicación de Discord y conservar solo en el entorno privado.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_INVITE_CHANNEL_ID=
# Base de datos Turso (libSQL). Reservado: el panel todavía guarda sus datos en Cloudflare y no usa estos campos.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
