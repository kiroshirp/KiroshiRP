# Archivo privado. Copiar a .env y completar SOLO en el ordenador/servidor privado.
# No utilizar nombres PUBLIC_ ni VITE_ para estas credenciales.
# Acceso al panel del equipo. Recomendado: Discord. IDs de Discord del equipo separados por comas
# (Ajustes > Avanzado > Modo desarrollador; clic derecho en el perfil > Copiar ID de usuario).
ADMIN_DISCORD_IDS=
# Alternativa: usuario y contraseña compartidos (13 caracteres o más). Para apagarla sin borrarla: ADMIN_PASSWORD_LOGIN=off
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_LOGIN=
# Solo para publicar el administrador en Cloudflare. Nunca se envían al navegador.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Acceso a Discord: configurar en la aplicación de Discord y conservar solo en el entorno privado.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_INVITE_CHANNEL_ID=
# Base de datos Turso (libSQL): guarda las cuentas, fichas y solicitudes del panel. Se sube como secreto del Worker al desplegar.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
