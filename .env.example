# Archivo privado. Copiar a .env y completar SOLO en el ordenador/servidor privado.
# No utilizar nombres PUBLIC_ ni VITE_ para estas credenciales.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PORT=4310
# Solo para publicar el administrador en Cloudflare. Nunca se envían al navegador.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Token de GitHub limitado a kiroshirp/KiroshiRP, permiso Contents: read and write.
GITHUB_TOKEN=
