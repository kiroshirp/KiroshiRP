{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiroshirp-admin",
  "main": "admin/worker.mjs",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory":"admin/ui","binding":"ASSETS","run_worker_first":true,"html_handling":"none"},
  "durable_objects": {"bindings":[{"name":"ADMIN_STATE","class_name":"AdminState"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["AdminState"]}]
}
