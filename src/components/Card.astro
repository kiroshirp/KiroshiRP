---
import { getCollection } from 'astro:content';
import { url } from '../config';
import documents from '../data/regulation-documents.json';
const { entry, section } = Astro.props;
const document =
  section === 'normativas' ? documents[entry.id as keyof typeof documents] : undefined;
const pending = entry.data.status === 'Por documentar';
// El estado general de la sección se dice una vez en la cabecera; la ficha solo lo muestra si difiere.
const siblings = (await getCollection(section as any)) as any[];
const counts = new Map<string, number>();
siblings.forEach((e) => counts.set(e.data.status, (counts.get(e.data.status) || 0) + 1));
const common = [...counts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0];
const showStatus = counts.size > 1 && entry.data.status !== common;
---

{section === 'normativas' ? (
  <a
    class="regulation-card"
    href={url(section + '/' + entry.id + '/')}
    data-card
    data-category={entry.data.category}
    data-search={entry.data.title + ' ' + entry.data.description + ' ' + entry.data.category}
  >
    <span class="regulation-card-number mono">{String(entry.data.order).padStart(2, '0')}</span>
    <span class="regulation-card-content">
      <strong>{entry.data.title}</strong>
      <small>{entry.data.description}</small>
    </span>
    <span class="regulation-card-status">
      {document ? 'Borrador · Versión ' + document.version : 'En desarrollo'}
    </span>
    <span class="regulation-card-arrow" aria-hidden="true">
      ↗
    </span>
  </a>
) : (
  <a
    class:list={['card', 'visual-card', { 'card-pending': pending }]}
    href={url(section + '/' + entry.id + '/')}
    data-section={section}
    data-card
    data-category={entry.data.category}
    data-search={entry.data.title + ' ' + entry.data.description + ' ' + entry.data.category}
  >
    {entry.data.image && (
      <div class="card-visual">
        <img src={url(entry.data.image.path)} alt={entry.data.image.alt} loading="lazy" />
      </div>
    )}
    <div class="card-category">
      <span>{entry.data.category}</span>
    </div>
    <div class="card-copy">
      {section === 'actualizaciones' && (
        <div class="card-meta">
          <span class="mono">
            {entry.data.updated.toLocaleDateString('es-ES', { timeZone: 'UTC' })}
          </span>
        </div>
      )}
      <h3>{entry.data.title}</h3>
      {section === 'normativas' && (
        <span class="regulation-progress">
          {document ? 'Borrador · Versión ' + document.version : 'En desarrollo'}
        </span>
      )}
      <p>{entry.data.description}</p>
      <div class="card-foot">
        {showStatus && <span class="badge">{entry.data.status}</span>}
        <span class="mono">{pending ? 'VER QUÉ FALTA →' : 'DESCUBRIR →'}</span>
      </div>
    </div>
  </a>
)}
