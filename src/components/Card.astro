---
import { url } from '../config';
import documents from '../data/regulation-documents.json';
const { entry, section } = Astro.props;
const document =
  section === 'normativas' ? documents[entry.id as keyof typeof documents] : undefined;
const pending = entry.data.status === 'Por documentar';
---

{section === 'normativas' ? (
  <a
    class="regulation-card"
    href={url(section + '/' + entry.id + '/')}
    data-card
    data-category={entry.data.category}
    data-search={entry.data.title + ' ' + entry.data.description + ' ' + entry.data.category}
  >
    <span class="regulation-card-number mono">{String(entry.data.order).padStart(2, '0')}</span>
    <span class="regulation-card-content">
      <strong>{entry.data.title}</strong>
      <small>{entry.data.description}</small>
    </span>
    <span class="regulation-card-status">
      {document ? 'Borrador · Versión ' + document.version : 'En desarrollo'}
    </span>
    <span class="regulation-card-arrow" aria-hidden="true">
      ↗
    </span>
  </a>
) : (
  <a
    class:list={['card', 'visual-card', { 'card-pending': pending }]}
    href={url(section + '/' + entry.id + '/')}
    data-section={section}
    data-card
    data-category={entry.data.category}
    data-search={entry.data.title + ' ' + entry.data.description + ' ' + entry.data.category}
  >
    {entry.data.image && (
      <div class="card-visual">
        <img src={url(entry.data.image.path)} alt={entry.data.image.alt} loading="lazy" />
      </div>
    )}
    <div class="card-category">
      <span>{entry.data.category}</span>
      <span aria-hidden="true">↗</span>
    </div>
    <div class="card-copy">
      <div class="card-meta">
        {section === 'normativas' && (
          <span class="regulation-number mono">{String(entry.data.order).padStart(2, '0')}</span>
        )}
        <span>{entry.data.origin === 'CANON CYBERPUNK' ? 'UNIVERSO CYBERPUNK' : 'KIROSHIRP'}</span>
        <span class="mono">
          {pending
            ? 'EN PREPARACIÓN'
            : section === 'actualizaciones'
              ? entry.data.updated.toLocaleDateString('es-ES', { timeZone: 'UTC' })
              : 'LECTURA PÚBLICA'}
        </span>
      </div>
      <h3>{entry.data.title}</h3>
      {section === 'normativas' && (
        <span class="regulation-progress">
          {document ? 'Borrador · Versión ' + document.version : 'En desarrollo'}
        </span>
      )}
      <p>{entry.data.description}</p>
      <div class="card-foot">
        <span class="badge">{entry.data.status}</span>
        <span class="mono">
          {entry.data.factionStatus
            ? 'KIROSHIRP: ' + entry.data.factionStatus.toUpperCase()
            : pending
              ? 'VER QUÉ FALTA →'
              : 'DESCUBRIR →'}
        </span>
      </div>
    </div>
  </a>
)}
