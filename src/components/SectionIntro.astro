---
import { getCollection } from 'astro:content';
import { sections, url } from '../config';
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  image?: string;
  imageAlt?: string;
  count?: number;
}
const { title, description, eyebrow, image, imageAlt = '', count } = Astro.props;
const sectionId = sections.find((s) => Astro.url.pathname.split('/').includes(s.id))?.id;
const entries = sectionId
  ? (await getCollection(sectionId as any)).filter(
      (e: any) => sectionId !== 'actualizaciones' || e.data.published,
    )
  : [];
const statuses = new Set(entries.map((e: any) => e.data.status));
const factionStatuses = new Set(entries.map((e: any) => e.data.factionStatus));
// Estado general: solo se muestra si es el mismo en todas las fichas (las fichas lo repiten solo si difieren).
const generalStatus = entries.length && statuses.size === 1 ? [...statuses][0] : undefined;
const generalFaction =
  entries.length && factionStatuses.size === 1 ? [...factionStatuses][0] : undefined;
---

<header class:list={['section-intro', { 'section-intro-visual': image }]}>
  <div class="section-intro-copy">
    <span class="eyebrow">{eyebrow}</span>
    <h1>
      {title}
      <span class="accent">.</span>
    </h1>
    <p>{description}</p>
    <div class="section-intro-bottom">
      {count !== undefined && count > 0 && (
        <span>
          <strong>{String(count).padStart(2, '0')}</strong> archivos para consultar
        </span>
      )}
      {(generalStatus || generalFaction) && (
        <span class="section-general-status">
          {generalStatus && <span class="badge">{generalStatus}</span>}
          {generalFaction && (
            <span class="mono">KIROSHIRP: {String(generalFaction).toUpperCase()}</span>
          )}
        </span>
      )}
      {count === 0 ? (
        <a href={url('discord/')}>
          Entrar a Discord <span aria-hidden="true">→</span>
        </a>
      ) : (
        <a href="#biblioteca">
          Explorar el contenido <span aria-hidden="true">↓</span>
        </a>
      )}
    </div>
  </div>
  {image && (
    <div class="section-intro-image">
      <img src={url(image)} alt={imageAlt} width="1000" height="700" fetchpriority="high" />
      <span class="section-image-mark" aria-hidden="true">
        KRP / ARCHIVO
      </span>
    </div>
  )}
</header>
