---
import {getCollection,getEntry} from 'astro:content';
import {url} from '../config';
import {districtSummary,serializeIndex} from '../lib/explorer.mjs';
import PortalArt from './PortalArt.astro';
const entries=(await getCollection('lore')).filter(e=>e.data.category==='Distritos').sort((a,b)=>a.data.order-b.data.order);
const districts=await Promise.all(entries.map(async e=>{
 const summary=districtSummary(e.body||'');if(!summary||!summary.atmosphere||!summary.places.length)throw new Error('Falta Vista rápida en '+e.id);
 const organizations=await Promise.all(summary.organizations.map(async o=>{const [collection,id]=o.path.split('/');const related=await getEntry(collection as 'lore'|'facciones',id);if(!related)throw new Error('Referencia no encontrada: '+o.path);return {...o,sources:related.data.sources};}));
 const sources=[e.data.sources,...organizations.map(o=>o.sources)].flat().filter((s,i,a)=>a.findIndex(x=>x.url===s.url)===i);
 return {id:e.id,title:e.data.title,summary:{...summary,organizations},sources,licensedText:e.data.licensedText};
}));
const indexData=serializeIndex(districts.map(({id,title,summary})=>({id,title,summary})));
---
<section class="section atlas" id="explorador" data-atlas><div class="atlas-controls" data-atlas-tools hidden><label for="atlas-search"><span class="mono">¿QUÉ QUIERES ENCONTRAR?</span><input type="search" id="atlas-search" placeholder="Kabuki, Arroyo, Nómadas…" autocomplete="off"/></label><div class="atlas-types" role="group" aria-label="Tipo de información"><button type="button" data-atlas-type="todo" aria-pressed="true">Todo</button><button type="button" data-atlas-type="ambiente" aria-pressed="false">Ambiente</button><button type="button" data-atlas-type="lugares" aria-pressed="false">Lugares</button><button type="button" data-atlas-type="organizaciones" aria-pressed="false">Organizaciones</button></div></div>
<div class="atlas-layout"><nav class="atlas-index" aria-label="Elegir distrito o las Badlands"><div class="atlas-index-heading"><span class="eyebrow">ÍNDICE DE ZONAS</span><span class="mono">6 DISTRITOS + BADLANDS</span></div>{districts.map((d,i)=><a href={'#zona-'+d.id} data-atlas-zone={d.id}><span class="mono">{String(i+1).padStart(2,'0')}</span><span>{d.title}</span><span aria-hidden="true">↗</span></a>)}<p class="atlas-index-note">Selecciona una zona para descubrirla. Este índice no es un mapa geográfico.</p><a class="atlas-plan-link" href={url('lore/protocolo-umbral/')}>APERTURA DE KIROSHIRP ↗</a></nav>
<div class="atlas-content"><p class="atlas-result mono" role="status" aria-live="polite" data-atlas-status hidden></p><div class="atlas-empty" data-atlas-empty hidden><h2>No encontramos esa referencia.</h2><p>Prueba con el nombre de una zona, un lugar o una organización documentada.</p><button class="button" type="button" data-atlas-reset>RESTABLECER BÚSQUEDA</button></div>
{districts.map(d=><section class="atlas-panel" id={'zona-'+d.id} aria-labelledby={'atlas-title-'+d.id} data-atlas-panel={d.id}><header class="atlas-panel-heading"><div class="atlas-panel-art"><PortalArt kind={d.id==='badlands'?'route':'city'}/></div><span class="eyebrow">CANON CYBERPUNK / {d.id==='badlands'?'LAS AFUERAS':'DISTRITO'}</span><h2 id={'atlas-title-'+d.id}>{d.title}</h2><span class="badge">ARCHIVO DEL UNIVERSO</span></header><div class="atlas-panel-body"><div class="atlas-category" data-atlas-category="ambiente"><span class="eyebrow">01 / AMBIENTE</span><p class="atlas-atmosphere">{d.summary.atmosphere}</p></div><section class="atlas-category" data-atlas-category="lugares"><div class="atlas-subheading"><h3>Lugares de referencia</h3><span class="mono">{d.summary.places.length.toString().padStart(2,'0')} EN ESTA FICHA</span></div><div class="atlas-places">{d.summary.places.map((p,i)=><article><span class="place-index mono">{String(i+1).padStart(2,'0')}</span><h4>{p.name}</h4><p>{p.description}</p></article>)}</div></section><section class="atlas-category" data-atlas-category="organizaciones"><div class="atlas-subheading"><h3>Organizaciones relacionadas</h3><span class="mono">CONTEXTO DEL UNIVERSO</span></div>{d.summary.organizations.length?<div class="atlas-organizations">{d.summary.organizations.map(o=><a href={url(o.path+'/')}><span class="organization-mark" aria-hidden="true">↗</span><span><strong>{o.name}</strong><small>{o.description}</small></span></a>)}</div>:<p class="atlas-unassigned">{d.summary.organizationNote} <a href={url('facciones/')}>Explora las fichas de organizaciones ↗</a></p>}</section><div class="atlas-panel-actions"><a class="button primary" href={url('lore/'+d.id+'/')}>LEER LA FICHA COMPLETA ↗</a><a class="text-link" href={url('lore/protocolo-umbral/')}>CONSULTAR EL PLAN DE APERTURA →</a></div><p class="atlas-availability">La información describe Cyberpunk 2077. No confirma que estos lugares, servicios u organizaciones estén disponibles en KiroshiRP.</p><details class="atlas-sources"><summary>Fuentes y atribución</summary><p>Resumen editorial elaborado a partir de las fichas documentadas del portal y sus fuentes. El texto adaptado de Cyberpunk Wiki conserva la licencia <a href="https://creativecommons.org/licenses/by-sa/3.0/deed.es" target="_blank" rel="noopener noreferrer">CC BY-SA 3.0</a>. Las ilustraciones son recursos de interfaz propios y no representan la geografía de la zona.</p><ul>{d.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></li>)}</ul></details></div></section>)}
</div></div><script type="application/json" data-atlas-index set:html={indexData}/></section>
<script>
import {matchesDistrict} from '../lib/explorer.mjs';
const root=document.querySelector<HTMLElement>('[data-atlas]');
if(root){
 const data=JSON.parse(root.querySelector('[data-atlas-index]')!.textContent||'[]');
 const tools=root.querySelector<HTMLElement>('[data-atlas-tools]')!;const input=root.querySelector<HTMLInputElement>('#atlas-search')!;const status=root.querySelector<HTMLElement>('[data-atlas-status]')!;const empty=root.querySelector<HTMLElement>('[data-atlas-empty]')!;const links=[...root.querySelectorAll<HTMLAnchorElement>('[data-atlas-zone]')];const panels=[...root.querySelectorAll<HTMLElement>('[data-atlas-panel]')];const typeButtons=[...root.querySelectorAll<HTMLButtonElement>('[data-atlas-type]')];
 let selected=new URL(location.href).searchParams.get('zona')||location.hash.replace('#zona-','')||'badlands';let type='todo';if(!data.some((d:any)=>d.id===selected))selected='badlands';
 function render(){const found=data.filter((d:any)=>matchesDistrict(d,input.value,type));const ids=new Set(found.map((d:any)=>d.id));if(!ids.has(selected)&&found.length)selected=found[0].id;links.forEach(link=>{link.hidden=!ids.has(link.dataset.atlasZone);const active=link.dataset.atlasZone===selected&&ids.has(selected);if(active)link.setAttribute('aria-current','true');else link.removeAttribute('aria-current');});panels.forEach(panel=>{panel.hidden=panel.dataset.atlasPanel!==selected||!ids.has(selected);panel.querySelectorAll<HTMLElement>('[data-atlas-category]').forEach(category=>category.hidden=type!=='todo'&&category.dataset.atlasCategory!==type);});typeButtons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.atlasType===type)));empty.hidden=found.length>0;status.textContent=found.length?(found.length===1?'1 zona encontrada':'Más de una zona coincide: '+found.length)+' · '+data.find((d:any)=>d.id===selected)?.title:'Ninguna zona coincide con la búsqueda.';}
 links.forEach(link=>link.addEventListener('click',event=>{event.preventDefault();selected=link.dataset.atlasZone!;render();const target=new URL(location.href);target.searchParams.set('zona',selected);target.hash='explorador';history.replaceState(null,'',target);const heading=root.querySelector<HTMLElement>('#atlas-title-'+selected);heading?.setAttribute('tabindex','-1');heading?.focus({preventScroll:true});heading?.scrollIntoView({block:'start',behavior:'auto'});}));
 typeButtons.forEach(button=>button.addEventListener('click',()=>{type=button.dataset.atlasType!;render();}));input.addEventListener('input',render);root.querySelector('[data-atlas-reset]')!.addEventListener('click',()=>{input.value='';type='todo';selected='badlands';render();input.focus();});
 tools.hidden=false;status.hidden=false;render();
}
</script>
