---
import {getCollection} from 'astro:content';
import {url} from '../config';
const districts=(await getCollection('lore')).filter(e=>e.data.category==='Distritos');
---
<section class="section city-explorer"><div class="section-heading"><div><span class="eyebrow">UN SOLO LUGAR. MUCHAS CARAS.</span><h2>Encuentra tu<br/><em>rincón de Night City.</em></h2></div><a class="text-link" href={url('lore/')}>TODO EL UNIVERSO ↗</a></div><div class="district-layout"><div class="district-scene"><img src={url('images/kiroshi-original.jpg')} alt="Ilustración de marca de KiroshiRP: el horizonte de Night City" width="1024" height="571" loading="lazy"/><div><span class="mono">CANON CYBERPUNK / DISTRITOS</span><h3>La misma ciudad.<br/>Distintas vidas.</h3><p>Explora sus contrastes antes de decidir dónde encaja tu personaje.</p></div><span class="district-caption mono">IMAGEN DE MARCA · NO REPRESENTA UN DISTRITO CONCRETO</span></div><nav class="district-list" aria-label="Explorar distritos">{districts.map((d,i)=><a href={url('lore/'+d.id+'/')}><span class="district-index mono">{String(i+1).padStart(2,'0')}</span><span><strong>{d.data.title}</strong><small>{d.data.description}</small></span><span class="district-arrow" aria-hidden="true">↗</span></a>)}</nav></div></section>
