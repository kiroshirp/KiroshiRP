---
import { url } from '../config';
const href = url('discord/');
---

<a class="discord-access" href={href} aria-label="Ver el acceso al Discord oficial de KiroshiRP">
  <span class="discord-access-content">
    <span class="mono">CANAL OFICIAL / DISCORD</span>
    <span class="discord-access-brand">
      <img src={url('images/kiroshi-logo.webp')} alt="" width="64" height="64" loading="lazy" />
      <strong>
        KIROSHI<span>RP</span>
      </strong>
    </span>
    <span class="discord-access-caption">
      Identifícate y solicita una invitación a la comunidad.
    </span>
    <span class="discord-access-action">
      Ir al acceso <span aria-hidden="true">↗</span>
    </span>
  </span>
</a>
