---
interface Props { kind?: string; compact?: boolean }
const {kind='city',compact=false}=Astro.props;
const network=['facciones','community','reputacion','facciones-progresion'].includes(kind);
const circuit=['mecanicas','cyberpsicosis','ciberware'].includes(kind);
const route=['guias','route','protocolo-umbral','primeros-pasos'].includes(kind);
