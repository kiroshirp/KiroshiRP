---
import '@fontsource/rajdhani/500.css';
import '@fontsource/rajdhani/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/800.css';
import '@fontsource/share-tech-mono';
import '../styles/tokens.css';
import '../styles/portal.css';
import '../styles/polish.css';
import '../styles/mobile-nav.css';
import '../styles/search.css';
import OpticalShell from '../components/OpticalShell.astro';
import { site, url, brand } from '../config';
import Discord from '../components/Discord.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props {
  title?: string;
  description?: string;
  active?: string;
  noindex?: boolean;
}
const {
  title = brand.primary,
  description = site.description,
  active = '',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(url('images/krp-share-v2.jpg'), Astro.site);
const path = Astro.url.pathname;
const inSection = (names: string[]) =>
  names.some((n) => new RegExp(`/${n}(/|$)`).test(path)) ? 'true' : undefined;
const universe = inSection(['lore', 'facciones', 'mecanicas', 'explorar']);
const start = inSection(['guias', 'normativas']);
const project = inSection(['actualizaciones', 'studio', 'contacto']);
const accountUrl = site.adminUrl ? new URL('/cuenta/', site.adminUrl).href : '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071525" />
    <title>{title} | KiroshiRP</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | KiroshiRP`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta
      property="og:image:alt"
      content="Un viajero contempla Night City: ilustración de KiroshiRP"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <meta
      name="twitter:image:alt"
      content="Un viajero contempla Night City: ilustración de KiroshiRP"
    />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
  </head>
  <body class:list={{ 'optic-home': active === 'inicio', 'studio-home': active === 'studio' }}>
    <OpticalShell />
    <a class="skip" href="#contenido">
      Saltar al contenido
    </a>
    <header class="site-header">
      <a class="wordmark" href={url()} aria-label="KiroshiRP, inicio">
        <img
          class="brand-logo"
          src={url('images/kiroshi-logo.webp')}
          alt=""
          width="79"
          height="26"
        />
        <span>
          KIROSHI<small>ROLEPLAY</small>
        </span>
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="navigation">
        MENÚ ☰
      </button>
      <nav id="navigation" aria-label="Principal">
        <a href={url()} aria-current={active === 'inicio' ? 'page' : undefined}>
          Inicio
        </a>
        <details class="nav-group">
          <summary aria-current={universe}>
            Universo Kiroshi <span aria-hidden="true">⌄</span>
          </summary>
          <div>
            <a href={url('lore/')}>Lore de Night City</a>
            <a href={url('facciones/')}>Facciones</a>
            <a href={url('mecanicas/')}>Mecánicas</a>
            <a href={url('explorar/')}>Explorar la ciudad</a>
          </div>
        </details>
        <details class="nav-group">
          <summary aria-current={start}>
            Cómo empezar <span aria-hidden="true">⌄</span>
          </summary>
          <div>
            <a href={url('guias/primeros-pasos/')}>Primeros pasos</a>
            <a href={url('guias/')}>Todas las guías</a>
            <a href={url('normativas/')}>Normativas</a>
          </div>
        </details>
        <details class="nav-group">
          <summary aria-current={project}>
            El proyecto <span aria-hidden="true">⌄</span>
          </summary>
          <div>
            <a href={url('actualizaciones/')}>Actualizaciones</a>
            <a href={url('studio/')}>Kiroshi Studio</a>
            <a href={url('contacto/')}>Contacto</a>
          </div>
        </details>
        <a class="nav-search" href={url('buscar/')}>
          Buscar
        </a>
        {accountUrl && (
          <a class="nav-account" href={accountUrl}>
            Mi cuenta
          </a>
        )}
        <Discord />
      </nav>
    </header>
    <div class="nav-scrim" hidden></div>
    <main id="contenido">
      <slot />
    </main>
    <SiteFooter />
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#navigation');
      const scrim = document.querySelector<HTMLElement>('.nav-scrim');
      const root = document.documentElement;
      const isOpen = () => toggle?.getAttribute('aria-expanded') === 'true';
      const setMenu = (open: boolean, refocus = false) => {
        if (!toggle) return;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.textContent = open ? 'CERRAR ✕' : 'MENÚ ☰';
        nav?.classList.toggle('open', open);
        root.classList.toggle('menu-open', open);
        if (scrim) scrim.hidden = !open;
        if (!open && refocus) toggle.focus();
      };
      toggle?.addEventListener('click', () => setMenu(!isOpen()));
      scrim?.addEventListener('click', () => setMenu(false, true));
      nav?.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) setMenu(false);
      });
      matchMedia('(min-width:1181px)').addEventListener('change', (e) => {
        if (e.matches) setMenu(false);
      });
      // Atrapa Tab dentro del panel abierto (botón + panel).
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab' || !isOpen() || !nav || !toggle) return;
        const items = [toggle, ...nav.querySelectorAll<HTMLElement>('a[href],summary')].filter(
          (el) => el.offsetParent !== null,
        );
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) (e.preventDefault(), last.focus());
        else if (!e.shiftKey && document.activeElement === last)
          (e.preventDefault(), first.focus());
      });
      const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>('.nav-group'));
      if (matchMedia('(max-width:760px)').matches)
        document.querySelector('.toc details')?.removeAttribute('open');
      const closeGroups = () => groups.forEach((group) => (group.open = false));
      groups.forEach((group) =>
        group.addEventListener('toggle', () => {
          if (group.open)
            groups.filter((other) => other !== group).forEach((other) => (other.open = false));
        }),
      );
      document.addEventListener('click', (event) => {
        if (event.target instanceof Node && !nav?.contains(event.target)) closeGroups();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const opened = groups.find((group) => group.open);
          closeGroups();
          opened?.querySelector('summary')?.focus();
          if (isOpen()) setMenu(false, true);
        }
      });
      window.addEventListener(
        'scroll',
        () =>
          document.querySelector('.site-header')?.classList.toggle('scrolled', window.scrollY > 30),
        { passive: true },
      );
    </script>
  </body>
</html>
