---
import Base from '../layouts/Base.astro';
import homeData from '../data/home.json';
import { homeSchema } from '../../admin/schema.mjs';
import { url, sections } from '../config';
import { getCollection } from 'astro:content';
import DiscordAccess from '../components/DiscordAccess.astro';
const home = homeSchema.parse(homeData);
const news = (await getCollection('actualizaciones'))
  .filter((e) => e.data.published)
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf())
  .slice(0, 3);
---

<Base active="inicio">
  <section class="clean-hero" aria-labelledby="home-title">
    <div class="clean-hero-copy">
      <h1 id="home-title">
        Roleplay <em>KiroshiRP</em>
        <br />
        Cyberpunk 2077
        <br />
        en Night City.
      </h1>
      <p class="clean-hero-lead">{home.texts.subtitulo}</p>
      <p>{home.texts.descripcion}</p>
      <span class="clean-status mono">{home.texts.estadoUniverso} · OPEN//77</span>
      <div class="actions">
        <a class="button primary" href={url('discord/')}>
          Entrar a Discord <span aria-hidden="true">→</span>
        </a>
        <a class="hero-guide" href={url('guias/primeros-pasos/')}>
          Consulta los primeros pasos →
        </a>
      </div>
    </div>
    <div class="clean-hero-media">
      <img
        src={url('images/krp-arrival.webp')}
        alt="Un viajero contempla la ciudad desde una carretera en el desierto"
        width="1672"
        height="941"
        fetchpriority="high"
      />
    </div>
  </section>

  <div class="portal-facts" aria-label="Sobre KiroshiRP">
    <div>
      <strong>Roleplay en Night City</strong>
      <span>Universo Cyberpunk 2077</span>
    </div>
    <div>
      <strong>Proyecto en construcción</strong>
      <span>Sin fecha de apertura confirmada</span>
    </div>
    <div>
      <strong>Archivo público</strong>
      <span>Consulta libre, sin registro</span>
    </div>
    <div>
      <strong>Comunidad en Discord</strong>
      <span>Acceso mediante formulario</span>
    </div>
  </div>

  <section class="clean-section clean-intro clean-reveal" aria-labelledby="project-title">
    <div class="clean-intro-content">
      <span class="eyebrow">{home.texts.etiquetaProyecto}</span>
      <h2 id="project-title">
        {home.texts.tituloCiudad}
        <br />
        <em>{home.texts.tituloInfinitas}</em>
      </h2>
      <p class="lead">{home.texts.presentacion}</p>
      <p>{home.texts.descripcionProyecto}</p>
    </div>
  </section>

  <section class="clean-section" aria-labelledby="directory-title">
    <div class="clean-section-head">
      <div>
        <span class="eyebrow">EL ARCHIVO DE KIROSHIRP</span>
        <h2 id="directory-title">
          Conoce el mundo.
          <br />
          Encuentra tu historia.
        </h2>
      </div>
      <a class="text-link" href={url('buscar/')}>
        Buscar un tema ↗
      </a>
    </div>
    <div class="portal-directory">
      {sections.map((section) => (
        <a href={url(section.id + '/')}>
          <span class="mono">
            {section.code} / {section.label}
          </span>
          <h3>
            {section.title} <span aria-hidden="true">↗</span>
          </h3>
          <p>{section.subtitle}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="clean-section clean-paths" aria-labelledby="paths-title">
    <div class="clean-section-head clean-reveal">
      <div>
        <span class="eyebrow">TU PUNTO DE ENTRADA</span>
        <h2 id="paths-title">Elige por dónde empezar.</h2>
      </div>
    </div>
    <div class="clean-path-grid">
      <a class="clean-path-card clean-reveal" href={url('guias/primeros-pasos/')}>
        <span class="clean-path-art">
          <img
            src={url('images/landing-first-steps.webp')}
            alt=""
            width="724"
            height="600"
            loading="lazy"
          />
        </span>
        <span class="mono">01 / TU PRIMER PASO</span>
        <strong>Primeros pasos</strong>
        <small>El punto de llegada y tus primeros contactos.</small>
        <span class="clean-path-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
      <a class="clean-path-card clean-reveal" href={url('lore/protocolo-umbral/')}>
        <span class="clean-path-art">
          <img
            src={url('images/landing-threshold.webp')}
            alt=""
            width="724"
            height="600"
            loading="lazy"
          />
        </span>
        <span class="mono">02 / EL COMIENZO</span>
        <strong>Protocolo Umbral</strong>
        <small>El inicio en el este y el plan de apertura.</small>
        <span class="clean-path-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
      <a class="clean-path-card clean-reveal" href={url('normativas/')}>
        <span class="clean-path-art">
          <img
            src={url('images/landing-regulations.webp')}
            alt=""
            width="724"
            height="600"
            loading="lazy"
          />
        </span>
        <span class="mono">03 / DOCUMENTOS</span>
        <strong>Normativas</strong>
        <small>Consulta los borradores y su estado.</small>
        <span class="clean-path-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    </div>
    <a class="clean-path-search text-link" href={url('buscar/')}>
      ¿Buscas algo concreto? Consulta el archivo ↗
    </a>
  </section>

  {news.length > 0 && (
    <section class="clean-section" aria-labelledby="news-title">
      <div class="clean-section-head">
        <div>
          <span class="eyebrow">{home.texts.etiquetaNoticias}</span>
          <h2 id="news-title">{home.texts.tituloNoticias}</h2>
        </div>
        <a class="text-link" href={url('actualizaciones/')}>
          {home.texts.botonNoticias}
        </a>
      </div>
      <div class="clean-news">
        {news.map((entry) => (
          <a href={url(`actualizaciones/${entry.id}/`)}>
            <strong>{entry.data.title}</strong>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="clean-section discord-home" aria-label="Comunidad de KiroshiRP">
    <DiscordAccess />
  </section>

  <section class="clean-section portal-faq" aria-labelledby="faq-title">
    <div>
      <span class="eyebrow">ANTES DE EMPEZAR</span>
      <h2 id="faq-title">Lo que necesitas saber.</h2>
      <a class="text-link" href={url('guias/preguntas-frecuentes/')}>
        Todas las preguntas frecuentes ↗
      </a>
    </div>
    <div>
      <details>
        <summary>¿KiroshiRP ya está abierto?</summary>
        <p>
          El proyecto está en construcción. No hay una fecha de apertura confirmada. Las novedades
          se publicarán en el registro de actualizaciones y en la comunidad.
        </p>
      </details>
      <details>
        <summary>¿Necesito una cuenta para leer la web?</summary>
        <p>
          El archivo es público. Puedes consultar las guías, el lore y las normativas sin
          registrarte.
        </p>
      </details>
      <details>
        <summary>¿Cómo entro en Discord?</summary>
        <p>
          Identifícate con Discord y declara tu SteamID64 en el formulario de acceso. Al completarlo
          recibirás una invitación individual. El SteamID es declarado; no verificamos su
          titularidad.
        </p>
      </details>
      <details>
        <summary>¿Las normativas ya son definitivas?</summary>
        <p>
          Cada documento muestra su estado editorial. Los borradores y las propuestas requieren
          revisión y no confirman funciones disponibles en el servidor.
        </p>
      </details>
    </div>
  </section>
</Base>
