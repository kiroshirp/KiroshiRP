---
import Base from '../layouts/Base.astro';
import homeData from '../data/home.json';
import {homeSchema} from '../../admin/schema.mjs';
import {url} from '../config';
import {getCollection} from 'astro:content';
import PortalArt from '../components/PortalArt.astro';
const home=homeSchema.parse(homeData);
const news=(await getCollection('actualizaciones')).filter(e=>e.data.published).sort((a,b)=>b.data.updated.valueOf()-a.data.updated.valueOf()).slice(0,3);
---
<Base active="inicio">
  <section class="clean-hero" aria-labelledby="home-title">
    <div class="clean-hero-copy">
      <span class="eyebrow">{home.texts.bienvenida}</span>
      <h1 id="home-title">{home.texts.titularCiudad}<br/><em>{home.texts.titularHistorias}</em></h1>
      <p class="clean-hero-lead">{home.texts.subtitulo}</p>
      <p>{home.texts.descripcion}</p>
      <div class="actions"><a class="button primary" href={url('guias/primeros-pasos/')}>Empieza aquí <span aria-hidden="true">↗</span></a><a class="button" href={url('explorar/')}>Explorar Night City</a></div>
      <span class="clean-status mono">{home.texts.estadoUniverso}</span>
    </div>
    <div class="clean-hero-media"><img src={url('images/kiroshi-background.svg')} alt="Vista azul de Night City con el emblema de Kiroshi Roleplay" width="1024" height="571" fetchpriority="high"/></div>
  </section>

  <section class="clean-section clean-intro" aria-labelledby="project-title">
    <div><span class="eyebrow">{home.texts.etiquetaProyecto}</span><h2 id="project-title">{home.texts.tituloCiudad}<br/><em>{home.texts.tituloInfinitas}</em></h2></div>
    <div><p class="lead">{home.texts.presentacion}</p><p>{home.texts.descripcionProyecto}</p></div>
  </section>

  <section class="clean-section clean-paths" aria-labelledby="paths-title">
    <div class="clean-section-head"><div><span class="eyebrow">TU PUNTO DE ENTRADA</span><h2 id="paths-title">Elige por dónde empezar.</h2></div></div>
    <div class="clean-path-grid">
      <a class="clean-path-card" href={url('guias/primeros-pasos/')}><span class="clean-path-art"><PortalArt kind="route"/></span><span class="mono">01 / TU PRIMER PASO</span><strong>Primeros pasos</strong><small>El punto de llegada y tus primeros contactos.</small><span class="clean-path-arrow" aria-hidden="true">↗</span></a>
      <a class="clean-path-card" href={url('lore/protocolo-umbral/')}><span class="clean-path-art"><PortalArt kind="city"/></span><span class="mono">02 / EL COMIENZO</span><strong>Protocolo Umbral</strong><small>El inicio en el este y el plan de apertura.</small><span class="clean-path-arrow" aria-hidden="true">↗</span></a>
      <a class="clean-path-card" href={url('normativas/')}><span class="clean-path-art"><PortalArt kind="community"/></span><span class="mono">03 / DOCUMENTOS</span><strong>Normativas</strong><small>Consulta los borradores y su estado.</small><span class="clean-path-arrow" aria-hidden="true">↗</span></a>
    </div>
    <a class="clean-path-search text-link" href={url('buscar/')}>¿Buscas algo concreto? Consulta el archivo ↗</a>
  </section>

  {news.length>0&&<section class="clean-section" aria-labelledby="news-title"><div class="clean-section-head"><div><span class="eyebrow">{home.texts.etiquetaNoticias}</span><h2 id="news-title">{home.texts.tituloNoticias}</h2></div><a class="text-link" href={url('actualizaciones/')}>{home.texts.botonNoticias}</a></div><div class="clean-news">{news.map(entry=><a href={url(`actualizaciones/${entry.id}/`)}><strong>{entry.data.title}</strong><span aria-hidden="true">↗</span></a>)}</div></section>}

</Base>
