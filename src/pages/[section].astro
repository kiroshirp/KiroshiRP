---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import SectionIntro from '../components/SectionIntro.astro';
import SectionPicks from '../components/SectionPicks.astro';
import { sections, sectionExtras, url } from '../config';
import { getCollection } from 'astro:content';
import documents from '../data/regulation-documents.json';
export function getStaticPaths() {
  return sections.map((section) => ({ params: { section: section.id }, props: { section } }));
}
const { section } = Astro.props;
const entries = (await getCollection(section.id))
  .filter((e) => section.id !== 'actualizaciones' || e.data.published)
  .sort((a, b) => a.data.order - b.data.order);
const available = entries.filter((e) => e.data.status !== 'Por documentar');
const pending = entries.filter((e) => e.data.status === 'Por documentar');
const regulationDrafts =
  section.id === 'normativas' ? available.filter((e) => e.id in documents) : [];
const regulationInProgress =
  section.id === 'normativas' ? available.filter((e) => !(e.id in documents)) : [];
const categories = [...new Set(entries.map((e) => e.data.category))];
const extras = sectionExtras[section.id];
---

<Base title={section.title} active={section.id}>
  <SectionIntro
    title={section.title}
    description={section.subtitle}
    eyebrow={`${section.code} / ${section.label}`}
    image={extras.cover}
    count={entries.length}
  />
  {section.id === 'lore' && (
    <a class="atlas-library-entry" href={url('explorar/')}>
      <span class="mono">EXPLORACIÓN VISUAL</span>
      <strong>Distritos, lugares y organizaciones. Elige una zona y empieza a descubrir.</strong>
      <span>ABRIR EXPLORADOR ↗</span>
    </a>
  )}
  <SectionPicks section={section} entries={entries} ids={extras.picks} />
  <section id="biblioteca" class="section library" data-library={section.id}>
    <div class="library-heading">
      <div>
        <span class="eyebrow">
          {section.id === 'normativas' ? 'ESTRUCTURA DE NORMATIVAS' : 'EXPLORA A TU RITMO'}
        </span>
        <h2>{section.id === 'normativas' ? 'Documentos' : 'Todas las fichas'}</h2>
      </div>
      {section.id !== 'normativas' && <p>{extras.note}</p>}
    </div>
    <div class="filter-bar">
      <label>
        BUSCAR EN {section.title.toUpperCase()}
        <input id="filter-search" type="search" placeholder="Título, categoría o concepto…" />
      </label>
      {section.id !== 'normativas' && (
        <label>
          CATEGORÍA
          <select id="filter-category">
            <option value="">Todas las categorías</option>
            {categories.map((c) => (
              <option>{c}</option>
            ))}
          </select>
        </label>
      )}
    </div>
    <p id="result-count" role="status" class="mono">
      {section.id === 'normativas'
        ? `${regulationDrafts.length} borradores en versión 0.2 · ${regulationInProgress.length} apartados en desarrollo`
        : `${available.length} fichas para consultar${pending.length > 0 ? ' · ' + pending.length + ' por documentar' : ''}`}
    </p>
    {section.id === 'normativas' ? (
      <>
        <div class="regulation-list">
          {regulationDrafts.map((entry) => (
            <Card entry={entry} section={section.id} />
          ))}
        </div>
        <details class="regulation-more" id="regulation-more">
          <summary>
            En desarrollo <span class="mono">{regulationInProgress.length} apartados</span>
          </summary>
          <div class="regulation-list">
            {regulationInProgress.map((entry) => (
              <Card entry={entry} section={section.id} />
            ))}
          </div>
        </details>
      </>
    ) : (
      <div class="cards">
        {available.map((entry) => (
          <Card entry={entry} section={section.id} />
        ))}
      </div>
    )}
    {pending.length > 0 && (
      <details class="pending-library" id="pending-library">
        <summary>
          En preparación <span class="badge">{pending.length} fichas</span>
        </summary>
        <p>
          Estos sistemas aún no tienen documentación definitiva. Puedes consultar lo que falta por
          definir; no se anuncian como disponibles.
        </p>
        <div class="cards">
          {pending.map((entry) => (
            <Card entry={entry} section={section.id} />
          ))}
        </div>
      </details>
    )}
    <p id="no-results" class="empty" hidden>
      No hay resultados. Prueba otro término o categoría.
    </p>
    {!entries.length && (
      <div class="empty">
        <h2>Sin publicaciones oficiales todavía.</h2>
        <p>
          Las novedades aparecerán aquí cuando estén confirmadas. Puedes seguir la comunidad en
          Discord desde la cabecera.
        </p>
      </div>
    )}
  </section>
  <script>
    import '../scripts/library-filter.ts';
  </script>
</Base>
