---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import SectionIntro from '../components/SectionIntro.astro';
import {sections,url} from '../config';
import {getCollection} from 'astro:content';
import documents from '../data/regulation-documents.json';
export function getStaticPaths(){return sections.map(section=>({params:{section:section.id},props:{section}}))}
const {section}=Astro.props;
const entries=(await getCollection(section.id)).filter(e=>section.id!=='actualizaciones'||e.data.published).sort((a,b)=>a.data.order-b.data.order);
const available=entries.filter(e=>e.data.status!=='Por documentar');
const pending=entries.filter(e=>e.data.status==='Por documentar');
const regulationDrafts=section.id==='normativas'?available.filter(e=>e.id in documents):[];
const regulationInProgress=section.id==='normativas'?available.filter(e=>!(e.id in documents)):[];
const categories=[...new Set(entries.map(e=>e.data.category))];
const picks:Record<string,string[]>={lore:['protocolo-umbral','badlands','historia-night-city'],mecanicas:['reputacion','cyberpsicosis','liderazgo'],facciones:['nomadas','valentinos','ncpd'],normativas:[],guias:['primeros-pasos','preguntas-frecuentes','glosario'],actualizaciones:[]};
const selected=(picks[section.id]||[]).map(id=>entries.find(e=>e.id===id)).filter(Boolean);
const notes:Record<string,string>={lore:'El canon del universo y las historias originales de KiroshiRP están identificados en cada ficha.',mecanicas:'Explora el diseño de los sistemas. Las propuestas no confirman funciones disponibles en el servidor.',facciones:'Conoce las organizaciones del universo. Su presencia en el servidor se indica por separado.',normativas:'12 apartados. Las normativas 01, 02 y 03 son borradores en versión 0.2. Los demás apartados continúan en desarrollo.',guias:'Empieza por lo esencial y amplía la lectura a tu ritmo.',actualizaciones:'Aquí solo se publican anuncios confirmados.'};
const covers:Record<string,string>={lore:'images/landing-threshold.webp',mecanicas:'images/krp-workshop.webp',facciones:'images/landing-project.webp',guias:'images/landing-first-steps.webp',normativas:'images/landing-regulations.webp'};
---
<Base title={section.title} active={section.id}><SectionIntro title={section.title} description={section.subtitle} eyebrow={`${section.code} / ${section.label}`} image={covers[section.id]} count={entries.length}/>
{section.id==='lore'&&<a class="atlas-library-entry" href={url('explorar/')}><span class="mono">EXPLORACIÓN VISUAL</span><strong>Distritos, lugares y organizaciones. Elige una zona y empieza a descubrir.</strong><span>ABRIR EXPLORADOR ↗</span></a>}
{selected.length>0&&<section class="section section-picks"><span class="eyebrow">{section.id==='guias'?'ANTES DE EMPEZAR':'UN BUEN PUNTO DE PARTIDA'}</span><div class="pick-links">{selected.map((e,i)=>e&&<a href={url(section.id+'/'+e.id+'/')}><span class="mono">0{i+1}</span><div><small>{e.data.category}</small><strong>{e.data.title}</strong></div><span aria-hidden="true">↗</span></a>)}</div></section>}
<section id="biblioteca" class="section library" data-library={section.id}><div class="library-heading"><div><span class="eyebrow">{section.id==='normativas'?'ESTRUCTURA DE NORMATIVAS':'EXPLORA A TU RITMO'}</span><h2>{section.id==='normativas'?'Documentos':'Todas las fichas'}</h2></div>{section.id!=='normativas'&&<p>{notes[section.id]}</p>}</div><div class="filter-bar"><label>BUSCAR EN {section.title.toUpperCase()}<input id="filter-search" type="search" placeholder="Título, categoría o concepto…"/></label>{section.id!=='normativas'&&<label>CATEGORÍA<select id="filter-category"><option value="">Todas las categorías</option>{categories.map(c=><option>{c}</option>)}</select></label>}</div><p id="result-count" role="status" class="mono">{section.id==='normativas'?`${regulationDrafts.length} borradores en versión 0.2 · ${regulationInProgress.length} apartados en desarrollo`:`${available.length} fichas para consultar${pending.length>0?' · '+pending.length+' por documentar':''}`}</p>{section.id==='normativas'?<><div class="regulation-list">{regulationDrafts.map(entry=><Card entry={entry} section={section.id}/>)}</div><details class="regulation-more" id="regulation-more"><summary>En desarrollo <span class="mono">{regulationInProgress.length} apartados</span></summary><div class="regulation-list">{regulationInProgress.map(entry=><Card entry={entry} section={section.id}/>)}</div></details></>:<div class="cards">{available.map(entry=><Card entry={entry} section={section.id}/>)}</div>}
{pending.length>0&&<details class="pending-library" id="pending-library"><summary>En preparación <span class="badge">{pending.length} fichas</span></summary><p>Estos sistemas aún no tienen documentación definitiva. Puedes consultar lo que falta por definir; no se anuncian como disponibles.</p><div class="cards">{pending.map(entry=><Card entry={entry} section={section.id}/>)}</div></details>}
<p id="no-results" class="empty" hidden>No hay resultados. Prueba otro término o categoría.</p>{!entries.length&&<div class="empty"><h2>Sin publicaciones oficiales todavía.</h2><p>Las novedades aparecerán aquí cuando estén confirmadas. Puedes seguir la comunidad en Discord desde la cabecera.</p></div>}</section>
<script>
const input=document.querySelector<HTMLInputElement>('#filter-search')!;const select=document.querySelector<HTMLSelectElement>('#filter-category');const cards=[...document.querySelectorAll<HTMLElement>('[data-card]')];const resultCount=document.querySelector<HTMLElement>('#result-count')!;const initialCount=resultCount.textContent;const normalize=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();const pending=document.querySelector<HTMLDetailsElement>('#pending-library');const more=document.querySelector<HTMLDetailsElement>('#regulation-more');function filter(){let count=0;cards.forEach(c=>{const visible=normalize(c.dataset.search||'').includes(normalize(input.value))&&(!select?.value||c.dataset.category===select.value);c.hidden=!visible;if(visible)count++});const filtering=!!(input.value||select?.value);resultCount.textContent=filtering?`${count} ${count===1?'ficha encontrada':'fichas encontradas'}`:initialCount;document.querySelector<HTMLElement>('#no-results')!.hidden=count!==0||cards.length===0;if(more){const matches=more.querySelectorAll('[data-card]:not([hidden])').length;more.hidden=filtering&&!matches;more.open=filtering&&!!matches;more.querySelector<HTMLElement>('summary .mono')!.textContent=filtering?`${matches} ${matches===1?'resultado':'resultados'}`:`${more.querySelectorAll('[data-card]').length} apartados`;}if(pending){const hasMatch=!!pending.querySelector('[data-card]:not([hidden])');pending.hidden=!hasMatch;if(filtering)pending.open=hasMatch;else pending.open=false;}}input.addEventListener('input',filter);select?.addEventListener('change',filter);
</script></Base>
