---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import PortalArt from '../components/PortalArt.astro';
import {sections,url} from '../config';
import {getCollection} from 'astro:content';
export function getStaticPaths(){return sections.map(section=>({params:{section:section.id},props:{section}}))}
const {section}=Astro.props;
const entries=(await getCollection(section.id)).filter(e=>section.id!=='actualizaciones'||e.data.published).sort((a,b)=>a.data.order-b.data.order);
const available=entries.filter(e=>e.data.status!=='Por documentar');
const pending=entries.filter(e=>e.data.status==='Por documentar');
const categories=[...new Set(entries.map(e=>e.data.category))];
const picks:Record<string,string[]>={lore:['protocolo-umbral','badlands','historia-night-city'],mecanicas:['reputacion','cyberpsicosis','liderazgo'],facciones:['nomadas','valentinos','ncpd'],normativas:[],guias:['primeros-pasos','preguntas-frecuentes','glosario'],actualizaciones:[]};
const selected=(picks[section.id]||[]).map(id=>entries.find(e=>e.id===id)).filter(Boolean);
const notes:Record<string,string>={lore:'El canon del universo y las historias originales de KiroshiRP están identificados en cada ficha.',mecanicas:'Explora el diseño de los sistemas. Las propuestas no confirman funciones disponibles en el servidor.',facciones:'Conoce las organizaciones del universo. Su presencia en el servidor se indica por separado.',normativas:'12 apartados. General y convivencia e interpretación, violencia y CK son borradores. Los demás apartados continúan en desarrollo.',guias:'Empieza por lo esencial y amplía la lectura a tu ritmo.',actualizaciones:'Aquí solo se publican anuncios confirmados.'};
---
<Base title={section.title} active={section.id}><section class="page-heading section section-cover"><div class="cover-copy"><span class="eyebrow">{section.code} / {section.label}</span><h1>{section.title}<span class="accent">.</span></h1><p>{section.subtitle}</p><a class="button primary" href="#biblioteca">{section.id==='guias'?'ENCUENTRA TU PRIMER PASO':'EXPLORAR LA SECCIÓN'} ↓</a></div><div class="cover-art"><PortalArt kind={section.id}/><span class="mono">KIROSHIRP / {section.title.toUpperCase()}</span></div></section>
{section.id==='lore'&&<a class="atlas-library-entry" href={url('explorar/')}><span class="mono">EXPLORACIÓN VISUAL</span><strong>Distritos, lugares y organizaciones. Elige una zona y empieza a descubrir.</strong><span>ABRIR EXPLORADOR ↗</span></a>}
{selected.length>0&&<section class="section section-picks"><span class="eyebrow">{section.id==='guias'?'ANTES DE EMPEZAR':'UN BUEN PUNTO DE PARTIDA'}</span><div class="pick-links">{selected.map((e,i)=>e&&<a href={url(section.id+'/'+e.id+'/')}><span class="mono">0{i+1}</span><div><small>{e.data.category}</small><strong>{e.data.title}</strong></div><span aria-hidden="true">↗</span></a>)}</div></section>}
<section id="biblioteca" class="section library" data-library={section.id}><div class="library-heading"><div><span class="eyebrow">{section.id==='normativas'?'ESTRUCTURA DE NORMATIVAS':'EXPLORA A TU RITMO'}</span><h2>{section.id==='normativas'?'Documentos para consultar':'Todas las fichas'}</h2></div><p>{notes[section.id]}</p></div><div class="filter-bar"><label>BUSCAR EN {section.title.toUpperCase()}<input id="filter-search" type="search" placeholder="Título, categoría o concepto…"/></label><label>CATEGORÍA<select id="filter-category"><option value="">Todas las categorías</option>{categories.map(c=><option>{c}</option>)}</select></label></div><p id="result-count" role="status" class="mono">{available.length} fichas para consultar{pending.length>0?' · '+pending.length+' por documentar':''}</p><div class="cards">{available.map(entry=><Card entry={entry} section={section.id}/>)}</div>
{pending.length>0&&<details class="pending-library" id="pending-library"><summary>En preparación <span class="badge">{pending.length} fichas</span></summary><p>Estos sistemas aún no tienen documentación definitiva. Puedes consultar lo que falta por definir; no se anuncian como disponibles.</p><div class="cards">{pending.map(entry=><Card entry={entry} section={section.id}/>)}</div></details>}
<p id="no-results" class="empty" hidden>No hay resultados. Prueba otro término o categoría.</p>{!entries.length&&<div class="empty"><h2>Sin publicaciones oficiales todavía.</h2><p>Las novedades aparecerán aquí cuando estén confirmadas. Puedes seguir la comunidad en Discord desde la cabecera.</p></div>}</section>
<script>
const input=document.querySelector<HTMLInputElement>('#filter-search')!;const select=document.querySelector<HTMLSelectElement>('#filter-category')!;const cards=[...document.querySelectorAll<HTMLElement>('[data-card]')];const normalize=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();const pending=document.querySelector<HTMLDetailsElement>('#pending-library');function filter(){let count=0;cards.forEach(c=>{const visible=normalize(c.dataset.search||'').includes(normalize(input.value))&&(!select.value||c.dataset.category===select.value);c.hidden=!visible;if(visible)count++});document.querySelector('#result-count')!.textContent=count+' fichas encontradas';document.querySelector<HTMLElement>('#no-results')!.hidden=count!==0||cards.length===0;if(pending){const hasMatch=!!pending.querySelector('[data-card]:not([hidden])');pending.hidden=!hasMatch;if(input.value||select.value)pending.open=hasMatch;else pending.open=false;}}input.addEventListener('input',filter);select.addEventListener('change',filter);
</script></Base>
