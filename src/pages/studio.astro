---
import Base from '../layouts/Base.astro';
import {site,url} from '../config';
---

<Base active="studio" title="Kiroshi Studio · Próximamente" description="Kiroshi Studio: el futuro espacio de recursos creados por KiroshiRP. Sección en preparación.">
  <section class="studio" aria-labelledby="studio-title">
    <div class="studio-scene" aria-hidden="true"><img src={url('images/kiroshi-background.svg')} alt="" width="1024" height="571" fetchpriority="high"/></div>
    <div class="studio-shell">
      <div class="studio-top mono"><span>KIROSHIRP / STUDIO</span><span>SECCIÓN EN PREPARACIÓN</span></div>
      <div class="studio-content">
        <div class="studio-copy">
          <span class="studio-eyebrow mono"><span aria-hidden="true" class="studio-signal"></span> CREACIONES DE KIROSHIRP</span>
          <h1 id="studio-title">KIROSHI<br/><em>STUDIO.</em></h1>
          <p class="studio-lead">Un espacio para los recursos creados por KiroshiRP.</p>
          <p class="studio-description">Estamos preparando esta sección. El catálogo todavía no está disponible.</p>
          {site.discord && <a class="studio-cta" href={url('discord/')}>Seguir novedades en Discord <span aria-hidden="true">↗</span></a>}
        </div>
        <div class="studio-preview" aria-label="Kiroshi Studio, próximamente">
          <div class="studio-preview-top mono"><span>KIROSHI / STUDIO</span><span aria-hidden="true">◌ ◌ ◌</span></div>
          <div class="studio-preview-center"><img src={url('images/kiroshi-logo.webp')} alt="" width="110" height="110"/><strong>PRÓXIMAMENTE</strong><span class="mono">ESPACIO DE RECURSOS / EN PREPARACIÓN</span></div>
          <div class="studio-preview-bottom mono"><span>KIROSHIRP</span><span>STUDIO // 01</span></div>
        </div>
      </div>
      <div class="studio-bottom mono"><span>LA MISMA CIUDAD. DISTINTAS PERSONAS.</span><a href={url()}>VOLVER A KIROSHIRP ↗</a></div>
    </div>
  </section>
</Base>

<style is:global>
  body.studio-home>main{width:100%;max-width:none;margin:0;background:transparent;overflow:visible}
  .studio{position:relative;isolation:isolate;min-height:100svh;overflow:hidden;background:#06111d;color:#ddf8f3}
  .studio-scene{position:absolute;inset:0;z-index:-2;overflow:hidden}
  .studio-scene img{width:100%;height:100%;object-fit:cover;object-position:center;opacity:.58;filter:saturate(.85)}
  .studio-scene:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#06111dfc 0%,#06111ddf 37%,#06111d5c 78%),linear-gradient(0deg,#06111df2,transparent 25%,transparent 75%,#06111d9c)}
  .studio:before{content:'';position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(#ddf8f308 1px,transparent 1px),linear-gradient(90deg,#ddf8f308 1px,transparent 1px);background-size:64px 64px;mask-image:linear-gradient(90deg,transparent 25%,#000)}
  .studio-shell{display:grid;grid-template-rows:auto 1fr auto;min-height:100svh;padding:108px max(5%,calc((100vw - 1400px)/2)) 26px}
  .studio-top,.studio-bottom{display:flex;justify-content:space-between;gap:20px;font-size:.72rem;letter-spacing:.18em;color:#ddf8f3b3}
  .studio-top span:last-child{color:var(--yellow)}
  .studio-content{display:grid;grid-template-columns:minmax(0,.93fr) minmax(0,1.07fr);align-items:center;gap:clamp(24px,5vw,90px);padding:55px 0}
  .studio-copy{max-width:660px}
  .studio-eyebrow{display:inline-flex;align-items:center;gap:12px;margin-bottom:26px;font-size:.77rem;letter-spacing:.2em;color:var(--yellow)}
  .studio-signal{width:7px;height:7px;border-radius:50%;background:var(--yellow);box-shadow:0 0 16px var(--yellow)}
  .studio h1{margin:0;font-family:Rajdhani,sans-serif;font-size:clamp(4.8rem,8.5vw,9.5rem);font-weight:700;line-height:.77;letter-spacing:-.065em;color:#f4fffd}
  .studio h1 em{font-style:normal;color:var(--yellow)}
  .studio-lead{max-width:540px;margin:34px 0 0;font-family:Rajdhani,sans-serif;font-size:clamp(1.4rem,2vw,2rem);font-weight:700;line-height:1.15;color:#f4fffd}
  .studio-description{max-width:500px;margin:16px 0 30px;color:#bed4dc;line-height:1.65}
  .studio-cta{display:inline-flex;justify-content:space-between;align-items:center;gap:30px;min-width:280px;padding:15px 18px;border:1px solid var(--yellow);background:var(--yellow);color:#06111d;font-family:Rajdhani,sans-serif;font-size:1.03rem;font-weight:700;text-decoration:none;transition:background .2s,color .2s,transform .2s}
  .studio-cta:hover,.studio-cta:focus-visible{background:#06111d;color:var(--yellow);transform:translateY(-2px)}
  .studio-preview{position:relative;display:grid;grid-template-rows:auto 1fr auto;min-height:480px;max-height:620px;aspect-ratio:1.12;border:1px solid #ddf8f355;clip-path:polygon(0 0,88% 0,100% 12%,100% 100%,12% 100%,0 88%);background:radial-gradient(circle at 55% 45%,#28719644,transparent 45%),linear-gradient(145deg,#102c49e8,#06111df2);box-shadow:0 26px 100px #0009}
  .studio-preview:before,.studio-preview:after{content:'';position:absolute;pointer-events:none}
  .studio-preview:before{inset:16px;border:1px solid #ddf8f321;clip-path:inherit}
  .studio-preview:after{inset:0;background:linear-gradient(115deg,transparent 35%,#ddf8f309 50%,transparent 65%)}
  .studio-preview-top,.studio-preview-bottom{display:flex;justify-content:space-between;gap:14px;margin:28px 32px;font-size:.68rem;letter-spacing:.14em;color:#bed4dc}
  .studio-preview-top span:last-child{color:var(--yellow)}
  .studio-preview-center{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:20px}
  .studio-preview-center img{width:110px;height:110px;object-fit:contain;margin-bottom:24px;filter:drop-shadow(0 12px 25px #0008)}
  .studio-preview-center strong{font-family:Rajdhani,sans-serif;font-size:clamp(2.2rem,4vw,4.6rem);letter-spacing:-.025em;line-height:1;color:#f4fffd}
  .studio-preview-center .mono{margin-top:12px;font-size:.65rem;letter-spacing:.14em;color:var(--yellow)}
  .studio-bottom{padding-top:20px;border-top:1px solid #ddf8f333}
  .studio-bottom a{color:#ddf8f3;text-decoration:none}
  .studio-bottom a:hover,.studio-bottom a:focus-visible{color:var(--yellow)}
  @media(max-width:900px){.studio-content{grid-template-columns:1fr;gap:44px}.studio-copy{max-width:720px}.studio-preview{width:min(100%,620px);min-height:360px;aspect-ratio:1.5;margin-inline:auto}.studio h1{font-size:clamp(5rem,12vw,8rem)}}
  @media(max-width:640px){.studio-shell{padding:98px 6% 24px}.studio-top span:last-child,.studio-bottom span{display:none}.studio-content{padding:45px 0;gap:38px}.studio h1{font-size:clamp(4.25rem,17vw,6rem)}.studio-lead{margin-top:26px}.studio-cta{width:100%;min-width:0}.studio-preview{min-height:290px;aspect-ratio:1.05}.studio-preview-top,.studio-preview-bottom{margin:20px;font-size:.58rem}.studio-preview-center img{width:82px;height:82px;margin-bottom:18px}.studio-preview-center strong{font-size:clamp(2rem,9vw,3.4rem)}.studio-preview-center .mono{font-size:.55rem}.studio-bottom{justify-content:flex-start}}
  @media(prefers-reduced-motion:reduce){.studio-cta{transition:none}.studio-cta:hover,.studio-cta:focus-visible{transform:none}}
</style>
