---
import {getCollection,getEntry,render} from 'astro:content';
import Base from '../layouts/Base.astro';
import OpeningPlan from '../components/OpeningPlan.astro';
import Notice from '../components/Notice.astro';
import PortalArt from '../components/PortalArt.astro';
import ReadingTools from '../components/ReadingTools.astro';
import {sections,url,phases,leadership} from '../config';
export async function getStaticPaths(){return (await Promise.all(sections.map(async s=>(await getCollection(s.id)).filter(e=>s.id!=='actualizaciones'||e.data.published).map(entry=>({params:{path:s.id+'/'+entry.id},props:{entry,section:s}}))))).flat()}
const {entry,section}=Astro.props;const {Content,headings}=await render(entry);const all=(await getCollection(section.id)).filter(e=>section.id!=='actualizaciones'||e.data.published).sort((a,b)=>a.data.order-b.data.order);const current=all.findIndex(e=>e.id===entry.id);const prev=all[current-1];const next=all[current+1];
const readingMinutes=Math.max(1,Math.ceil((entry.body||'').replace(/^---[\s\S]*?---/,'').split(/\s+/).length/220));
const relatedEntries=await Promise.all(entry.data.related.map(async (path:string)=>{const [collection,...parts]=path.split('/');const related=await getEntry(collection as any,parts.join('/'));return {path,title:related?.data.title||parts.join(' / ')};}));
---
<Base title={entry.data.title} description={entry.data.description} active={section.id}><div class="section article-shell" data-pagefind-body data-pagefind-filter={`seccion:${section.title}`}><nav class="breadcrumb" aria-label="Ruta"><a href={url()}>Inicio</a> / <a href={url(`${section.id}/`)}>{section.title}</a> / <span>{entry.data.title}</span></nav><header class="article-heading visual-article-heading"><div class="article-cover-art"><PortalArt kind={section.id}/></div><span class="eyebrow origin-label" data-origin={entry.data.origin}>{entry.data.origin} / {entry.data.category}</span><h1 data-pagefind-meta="title">{entry.data.title}</h1><p>{entry.data.description}</p><div class="article-meta"><span class="reading-time mono">{readingMinutes} MIN DE LECTURA</span><span class="badge">{entry.data.status}</span><span class="mono">REVISIÓN EDITORIAL · <time datetime={entry.data.updated.toISOString()}>{entry.data.updated.toLocaleDateString('es-ES',{timeZone:'UTC'})}</time></span></div></header><div class="article-grid"><aside class="toc" data-pagefind-ignore><details open><summary>EN ESTE ARCHIVO</summary><nav aria-label="Índice del artículo">{headings.filter(h=>h.depth<=3).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}{entry.id==='protocolo-umbral'&&<a href="#fases-de-apertura">Fases de apertura</a>}{entry.id==='cyberpsicosis'&&<a href="#fases-propuestas">Fases propuestas</a>}{['liderazgo','liderazgo-normas'].includes(entry.id)&&<a href="#parametros">Parámetros compartidos</a>}</nav></details><a class="text-link" href={url('buscar/')}>BUSCAR EN EL ARCHIVO ↗</a></aside><article class="prose"><section class="article-brief" aria-label="Resumen del archivo"><span class="eyebrow">ANTES DE LEER</span><p>{entry.data.description}</p><dl><div><dt>Origen</dt><dd>{entry.data.origin}</dd></div><div><dt>Estado del documento</dt><dd>{entry.data.status}</dd></div>{entry.data.factionStatus&&<div><dt>Estado en KiroshiRP</dt><dd>{entry.data.factionStatus}</dd></div>}</dl></section><Notice title={entry.data.status==='Documentado'?'Archivo del universo':entry.data.status==='Confirmado'?'Información del portal':`${entry.data.status} · pendiente de revisión`} kind={entry.data.origin==='CANON CYBERPUNK'?'lore':'development'}>{entry.data.universeScope || (entry.data.status==='Confirmado'?'Información pública sobre el proyecto.':entry.data.origin==='CANON CYBERPUNK'?'Ficha editorial del universo. Los apartados pendientes no constituyen información canónica verificada.':'Este contenido es una propuesta editorial. No establece normas vigentes ni confirma funciones implementadas en el servidor.')}</Notice>{entry.data.image&&<img class="article-image" src={url(entry.data.image.path)} alt={entry.data.image.alt} loading="lazy"/>}<ReadingTools/><div class="chapter-content" data-chapter-content><Content/></div>{entry.id==='protocolo-umbral'&&<OpeningPlan article/>}{entry.id==='cyberpsicosis'&&<section id="fases-propuestas"><h2>Fases propuestas</h2><p>Diseño orientativo, pendiente de aprobación. No representa un medidor activo ni una progresión inevitable.</p><ol class="phases">{phases.map(([name,description],i)=><li><span class="mono">0{i+1}</span><div><h3>{name}</h3><p>{description}</p></div></li>)}</ol></section>}{['liderazgo','liderazgo-normas'].includes(entry.id)&&<section id="parametros"><h2>Parámetros compartidos</h2><p>{leadership.status}. Esta tabla procede de la misma configuración en mecánicas y normativas.</p><dl class="parameters">{leadership.rules.map(([term,definition])=><div><dt>{term}</dt><dd>{definition}</dd></div>)}</dl></section>}{entry.data.licensedText&&<p class="source-credit" data-pagefind-ignore>Texto procedente de Cyberpunk Wiki en español y sus colaboradores, incorporado y reorganizado para este archivo bajo <a href="https://creativecommons.org/licenses/by-sa/3.0/deed.es" target="_blank" rel="noopener noreferrer">CC BY-SA 3.0</a>. Se han seleccionado apartados y retirado navegación, galerías y citas de interfaz; las referencias se conservan debajo. La licencia se aplica al texto adaptado, no a las marcas ni a las imágenes.</p>}{entry.data.sources.length>0&&<section data-pagefind-ignore><details><summary>Fuentes y atribución</summary><ul>{entry.data.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></li>)}</ul></details></section>}<section data-pagefind-ignore><h2>Archivos relacionados</h2><div class="related">{relatedEntries.map(item=><a href={url(item.path+'/')}>{item.title} ↗</a>)}</div><details><summary>Historial de cambios</summary>{entry.data.history.map(change=><p><time datetime={change.date.toISOString()}>{change.date.toLocaleDateString("es-ES",{timeZone:"UTC"})}</time> — {change.description}</p>)}<p>{entry.data.updated.toLocaleDateString('es-ES',{timeZone:'UTC'})} — Preparación editorial de esta ficha. No equivale a una actualización del servidor.</p></details><div class="prev-next">{prev?<a href={url(`${section.id}/${prev.id}/`)}>← {prev.data.title}</a>:<span/>}{next&&<a href={url(`${section.id}/${next.id}/`)}>{next.data.title} →</a>}</div></section></article></div></div></Base>

