---
import {getCollection,render} from 'astro:content';
import Base from '../layouts/Base.astro';
import Notice from '../components/Notice.astro';
import {sections,url,phases,leadership} from '../config';
export async function getStaticPaths(){return (await Promise.all(sections.map(async s=>(await getCollection(s.id)).filter(e=>s.id!=='actualizaciones'||e.data.published).map(entry=>({params:{path:s.id+'/'+entry.id},props:{entry,section:s}}))))).flat()}
const {entry,section}=Astro.props;const {Content,headings}=await render(entry);const all=(await getCollection(section.id)).filter(e=>section.id!=='actualizaciones'||e.data.published).sort((a,b)=>a.data.order-b.data.order);const current=all.findIndex(e=>e.id===entry.id);const prev=all[current-1];const next=all[current+1];
---
<Base title={entry.data.title} description={entry.data.description} active={section.id}><div class="section article-shell" data-pagefind-body data-pagefind-filter={`seccion:${section.title}`}><nav class="breadcrumb" aria-label="Ruta"><a href={url()}>Inicio</a> / <a href={url(`${section.id}/`)}>{section.title}</a> / <span>{entry.data.title}</span></nav><header class="article-heading"><span class="eyebrow">{entry.data.origin} / {entry.data.category}</span><h1 data-pagefind-meta="title">{entry.data.title}</h1><p>{entry.data.description}</p><div class="article-meta"><span class="badge">{entry.data.status}</span><span class="mono">REVISIÓN EDITORIAL · <time datetime={entry.data.updated.toISOString()}>{entry.data.updated.toLocaleDateString('es-ES',{timeZone:'UTC'})}</time></span></div></header><div class="article-grid"><aside class="toc" data-pagefind-ignore><details open><summary>EN ESTE ARCHIVO</summary><nav aria-label="Índice del artículo">{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}{entry.id==='cyberpsicosis'&&<a href="#fases-propuestas">Fases propuestas</a>}{['liderazgo','liderazgo-normas'].includes(entry.id)&&<a href="#parametros">Parámetros compartidos</a>}</nav></details><a class="text-link" href={url('buscar/')}>BUSCAR EN EL ARCHIVO ↗</a></aside><article class="prose"><Notice title={entry.data.status==='Confirmado'?'Información del portal':`${entry.data.status} · pendiente de revisión`} kind={entry.data.origin==='CANON CYBERPUNK'?'lore':'development'}>{entry.data.status==='Confirmado'?'Información pública sobre el proyecto.':entry.data.origin==='CANON CYBERPUNK'?'Ficha editorial del universo. Los apartados pendientes no constituyen información canónica verificada.':'Este contenido es una propuesta editorial. No establece normas vigentes ni confirma funciones implementadas en el servidor.'}</Notice>{entry.data.image&&<img class="article-image" src={url(entry.data.image.path)} alt={entry.data.image.alt} loading="lazy"/>}<Content/>{entry.id==='cyberpsicosis'&&<section id="fases-propuestas"><h2>Fases propuestas</h2><p>Diseño orientativo, pendiente de aprobación. No representa un medidor activo ni una progresión inevitable.</p><ol class="phases">{phases.map(([name,description],i)=><li><span class="mono">0{i+1}</span><div><h3>{name}</h3><p>{description}</p></div></li>)}</ol></section>}{['liderazgo','liderazgo-normas'].includes(entry.id)&&<section id="parametros"><h2>Parámetros compartidos</h2><p>{leadership.status}. Esta tabla procede de la misma configuración en mecánicas y normativas.</p><dl class="parameters">{leadership.rules.map(([term,definition])=><div><dt>{term}</dt><dd>{definition}</dd></div>)}</dl></section>}{entry.data.sources.length>0&&<section><h2>Fuentes de consulta</h2><ul>{entry.data.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></li>)}</ul></section>}<section data-pagefind-ignore><h2>Archivos relacionados</h2><div class="related">{entry.data.related.map(path=><a href={url(`${path}/`)}>{path.split('/').pop()?.replaceAll('-',' ')} ↗</a>)}</div><details><summary>Historial de cambios</summary>{entry.data.history.map(change=><p><time datetime={change.date.toISOString()}>{change.date.toLocaleDateString("es-ES",{timeZone:"UTC"})}</time> — {change.description}</p>)}<p>{entry.data.updated.toLocaleDateString('es-ES',{timeZone:'UTC'})} — Preparación editorial de esta ficha. No equivale a una actualización del servidor.</p></details><div class="prev-next">{prev?<a href={url(`${section.id}/${prev.id}/`)}>← {prev.data.title}</a>:<span/>}{next&&<a href={url(`${section.id}/${next.id}/`)}>{next.data.title} →</a>}</div></section></article></div></div></Base>

