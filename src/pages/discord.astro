---
import Base from '../layouts/Base.astro';
import {site,url} from '../config';
---
<Base title="Acceso a la comunidad" description="Entra en el Discord oficial de KiroshiRP y descubre el proyecto antes de participar.">
  <section class="discord-gate" aria-labelledby="discord-title">
    <div class="discord-gate-scene" aria-hidden="true"><img src={url('images/landing-project.webp')} alt="" width="1280" height="720" fetchpriority="high"/><img class="discord-gate-glitch" src={url('images/landing-project.webp')} alt="" width="1280" height="720"/></div>
    <div class="discord-gate-top mono"><span>KIROSHIRP <b>/</b> COMUNIDAD</span><span>ACCESO OFICIAL · DISCORD</span></div>
    <div class="discord-gate-content">
      <div class="discord-gate-identity"><img src={url('images/kiroshi-logo.webp')} alt="" width="86" height="86"/><span class="mono">KIROSHI<br/>ROLEPLAY</span></div>
      <span class="discord-gate-kicker mono">TU PUNTO DE ENTRADA</span>
      <h1 id="discord-title">NIGHT CITY.<br/><em>MÁS HISTORIAS.</em></h1>
      <p class="discord-gate-lead">La ciudad es la misma. Tu historia no.</p>
      {site.discord ? <><a class="discord-gate-cta" href={site.discord} target="_blank" rel="noopener noreferrer"><span>Entrar al Discord oficial</span><span aria-hidden="true">↗</span></a><p class="discord-gate-note">Se abrirá Discord en una pestaña nueva.</p></> : <p class="discord-gate-unavailable">El acceso al Discord aún no está disponible.</p>}
    </div>
    <div class="discord-gate-bottom mono"><span>KIROSHIRP / NIGHT CITY</span><a href="#antes-de-entrar">CONOCE EL PROYECTO <span aria-hidden="true">↓</span></a></div>
  </section>
  <section class="discord-gate-next" id="antes-de-entrar" aria-labelledby="discord-next-title"><div><span class="eyebrow">ANTES DE ENTRAR</span><h2 id="discord-next-title">Conoce KiroshiRP.</h2><p>Explora la guía de inicio y consulta las normativas publicadas como borradores.</p></div><nav aria-label="Lecturas recomendadas"><a href={url('guias/primeros-pasos/')}>Guía de inicio <span aria-hidden="true">↗</span></a><a href={url('normativas/')}>Normativas <span aria-hidden="true">↗</span></a></nav></section>
</Base>

<script>
  if (matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const gate=document.querySelector<HTMLElement>('.discord-gate');
    gate?.addEventListener('pointermove',event=>{
      const bounds=gate.getBoundingClientRect();
      gate.style.setProperty('--glitch-x',`${event.clientX-bounds.left}px`);
      gate.style.setProperty('--glitch-y',`${event.clientY-bounds.top}px`);
      gate.classList.add('has-pointer');
    });
    gate?.addEventListener('pointerleave',()=>gate.classList.remove('has-pointer'));
  }
</script>
