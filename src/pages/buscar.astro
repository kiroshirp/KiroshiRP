---
import Base from '../layouts/Base.astro';
---
<Base title="Buscar en el archivo"><section class="section page-heading"><span class="eyebrow">CONSULTA / BASE DE DATOS</span><h1>Encuentra tu respuesta<span class="accent">.</span></h1><p>Busca normas, mecánicas, facciones y conceptos. Los resultados se organizan por sección y enlazan a los apartados del archivo.</p></section><section class="section search-page"><label for="global-search">BUSCAR EN TODO EL ARCHIVO</label><input id="global-search" type="search" placeholder="Prueba «liderazgo», «implantes» o «Watson»…" autocomplete="off"/><p id="search-status" role="status">Escribe para consultar el archivo público.</p><div id="search-results"></div><noscript>Activa JavaScript para utilizar la búsqueda. Puedes navegar por las secciones desde la cabecera.</noscript></section><script>
const input=document.querySelector<HTMLInputElement>('#global-search')!;const status=document.querySelector('#search-status')!;const output=document.querySelector('#search-results')!;let generation=0;let timer:ReturnType<typeof setTimeout>;let engine:any;
input.addEventListener('input',()=>{clearTimeout(timer);const token=++generation;timer=setTimeout(async()=>{output.replaceChildren();const q=input.value.trim();if(!q){status.textContent='Escribe para consultar el archivo público.';return}status.textContent='Consultando…';try{engine ||= await import(/* @vite-ignore */ `${import.meta.env.BASE_URL.replace(/\/$/,'')}/pagefind/pagefind.js`);const search=await engine.search(q);const results=await Promise.all(search.results.slice(0,40).map((r:any)=>r.data()));if(token!==generation)return;status.textContent=`${search.results.length} archivos encontrados`;const groups=new Map<string,HTMLElement>();for(const r of results){const category=r.filters?.seccion?.[0]||'Archivo';if(!groups.has(category)){const section=document.createElement('section');const heading=document.createElement('h2');heading.textContent=category;section.append(heading);output.append(section);groups.set(category,section)}const list=r.sub_results?.length?r.sub_results:[{title:r.meta.title,url:r.url,excerpt:r.excerpt}];for(const item of list.slice(0,4)){const link=document.createElement('a');link.className='search-result';link.href=item.url;const title=document.createElement('h3');title.textContent=item.title||r.meta.title;const snippet=document.createElement('p');snippet.textContent=(item.excerpt||'').replace(/<[^>]*>/g,'');link.append(title,snippet);groups.get(category)!.append(link)}}}catch{if(token===generation)status.textContent='No se ha podido cargar el índice. Recarga la página o consulta las secciones del archivo.'}},160)});
</script></Base>
