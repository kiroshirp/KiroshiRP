---
import '../styles/membership.css';
import Base from '../layouts/Base.astro';
import { url } from '../config';
import m from '../data/membresia.json';

// Iconos vectoriales por línea (trazo, sin imágenes incrustadas).
const icons = [
  '<rect x="3" y="4" width="18" height="6" rx="1"/><rect x="3" y="14" width="18" height="6" rx="1"/><path d="M7 7h.01M7 17h.01"/>',
  '<path d="M8 8l-5 4 5 4M16 8l5 4-5 4M14 5l-4 14"/>',
  '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.5-4 3-6 6.5-6s6 2 6.5 6M17 4.5a3.5 3.5 0 010 7M18 14c2 .6 3.2 2.5 3.5 6"/>',
];
const niveles = m.niveles as {
  nombre: string;
  precio?: string;
  beneficios?: string[];
  estado?: string;
}[];
const huecos = Array.from({ length: m.huecos });
---

<Base
  image="images/krp-arrival.webp"
  active="membresia"
  title="Membresía · Apoyar KiroshiRP, un adelanto"
  description="Adelanto de la membresía de KiroshiRP: una forma voluntaria de apoyar el proyecto, sin ventajas en el juego. Nada está confirmado y todo puede cambiar."
>
  <div class="kmb" data-pagefind-body>
    <header class="kmb-hero" aria-labelledby="kmb-title">
      <img
        class="kmb-hero-img"
        src={url('images/krp-arrival.webp')}
        srcset={`${url('images/krp-arrival-640.webp')} 640w, ${url('images/krp-arrival-960.webp')} 960w, ${url('images/krp-arrival.webp')} 1672w`}
        sizes="(max-width: 1360px) 100vw, 1360px"
        alt="Una persona de espaldas, con chaqueta de detalles amarillos, mira de noche una ciudad futurista iluminada desde un risco"
        width="1672"
        height="941"
        fetchpriority="high"
      />
      <div class="kmb-hero-copy">
        <p class="kmb-route">
          <span class="kmb-chip">
            <span aria-hidden="true"></span>
            {m.estado}
          </span>
          <span class="mono">{m.eyebrow}</span>
        </p>
        <h1 id="kmb-title">
          {m.titulo}
          <span class="accent">.</span>
        </h1>
        <p class="kmb-lead">{m.lead}</p>
        <p class="kmb-desc">{m.descripcion}</p>
        <div class="kmb-actions">
          <a class="button primary" href={url('discord/')}>
            Seguir el proyecto en Discord <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </header>

    <p class="kmb-notice" role="note">
      {m.aviso}
    </p>

    <div class="kmb-main">
      <section class="kmb-guarantee" aria-labelledby="kmb-garantia-title">
        <h2 id="kmb-garantia-title">{m.garantiaTitulo}</h2>
        <p>{m.garantiaLead}</p>
        <ul class="kmb-no">
          {m.garantias.map((g) => (
            <li>
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="9" />
                <path d="M6 6l12 12" />
              </svg>
              <span>{g}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="kmb-levels" aria-labelledby="kmb-niveles-title">
        <h2 id="kmb-niveles-title">{m.nivelesTitulo}</h2>
        <p class="kmb-sub">{m.nivelesLead}</p>
        {niveles.length === 0 ? (
          <>
            <div class="kmb-grid">
              {huecos.map(() => (
                <article class="kmb-card kmb-ghost" aria-label={m.nivelesVacio.titulo}>
                  <svg
                    viewBox="0 0 24 24"
                    width="28"
                    height="28"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <rect x="5" y="11" width="14" height="9" rx="1.5" />
                    <path d="M8 11V8a4 4 0 018 0v3" />
                  </svg>
                  <span class="kmb-badge">{m.nivelesVacio.titulo}</span>
                  <span class="kmb-bar" aria-hidden="true" />
                  <span class="kmb-bar short" aria-hidden="true" />
                  <span class="kmb-bar" aria-hidden="true" />
                </article>
              ))}
            </div>
            <p class="kmb-legend">{m.huecosLeyenda}</p>
          </>
        ) : (
          <div class="kmb-grid">
            {niveles.map((n) => (
              <article class="kmb-card">
                <div class="kmb-card-top">
                  <h3>{n.nombre}</h3>
                  {n.estado && <span class="kmb-badge">{n.estado}</span>}
                </div>
                {n.precio && <p class="mono kmb-price">{n.precio}</p>}
                {n.beneficios && n.beneficios.length > 0 && (
                  <ul class="kmb-list">
                    {n.beneficios.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        )}
      </section>
    </div>

    <section class="kmb-money" aria-labelledby="kmb-destino-title">
      <h2 id="kmb-destino-title" class="mono kmb-kicker">
        {m.destinoTitulo} <span>· {m.destinoLead}</span>
      </h2>
      <div class="kmb-grid-3">
        {m.destino.map((d, i) => (
          <article class="kmb-card kmb-mini">
            <svg
              viewBox="0 0 24 24"
              width="28"
              height="28"
              aria-hidden="true"
              focusable="false"
              set:html={icons[i]}
            />
            <div>
              <h3>{d.titulo}</h3>
              <p>{d.texto}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <footer class="kmb-cta">
      <p>{m.cierre}</p>
      <div class="kmb-cta-links">
        <a class="button" href={url('discord/')}>
          {m.cta.boton} <span aria-hidden="true">→</span>
        </a>
        <a class="text-link" href={url('actualizaciones/')}>
          Ver las actualizaciones ↗
        </a>
      </div>
    </footer>
  </div>
</Base>
