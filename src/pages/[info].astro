---
import Base from '../layouts/Base.astro';
import {site,url} from '../config';
import data from '../data/legal.json';
import {legalSchema} from '../../admin/schema.mjs';
export function getStaticPaths(){return ['contacto','aviso-legal','privacidad'].map(info=>({params:{info}}))}
const info=Astro.params.info as keyof typeof data;
const page=legalSchema.parse(data)[info];
---
<Base title={page.title}><section class="section page-heading"><span class="eyebrow">INFORMACIÓN DEL PORTAL</span><h1>{page.title}</h1></section><section class="section prose">{page.sections.map(section=><section><h2>{section.title}</h2>{section.paragraphs.map(text=><p>{text}</p>)}</section>)}{info==='contacto'&&<><div class="actions">{site.discord&&<a href={site.discord}>Acceder al Discord oficial ↗</a>}{site.contact&&<a href={site.contact}>Contactar con el equipo ↗</a>}</div><p><a href={url('guias/')}>Guía de inicio</a> · <a href={url('guias/preguntas-frecuentes/')}>Preguntas frecuentes</a></p></>}</section></Base>
