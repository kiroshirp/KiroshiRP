---
import Base from '../layouts/Base.astro';
import { site, url } from '../config';
import data from '../data/legal.json';
import { legalSchema } from '../../admin/schema.mjs';
export function getStaticPaths() {
  return ['contacto', 'aviso-legal', 'privacidad'].map((info) => ({ params: { info } }));
}
const info = Astro.params.info as keyof typeof data;
const page = legalSchema.parse(data)[info];
---

<Base title={page.title}>
  <section class="section page-heading">
    <span class="eyebrow">INFORMACIÓN DEL PORTAL</span>
    <h1>{page.title}</h1>
  </section>
  <div class:list={['section', 'info-page', { 'article-grid': page.sections.length >= 3 }]}>
    {page.sections.length >= 3 && (
      <aside class="toc" data-info-toc>
        <details open>
          <summary>EN ESTE ARCHIVO</summary>
          <nav aria-label="Índice de la página">
            {page.sections.map((section, i) => (
              <a href={`#seccion-${i + 1}`}>{section.title}</a>
            ))}
          </nav>
        </details>
      </aside>
    )}
    <div class="prose info-prose">
      {page.sections.map((section, i) => (
        <section id={`seccion-${i + 1}`}>
          <h2>{section.title}</h2>
          {section.paragraphs.map((text) => (
            <p>{text}</p>
          ))}
        </section>
      ))}
      {info === 'contacto' && (
        <>
          <div class="actions info-actions">
            <a class="button primary" href={url('discord/')}>
              Solicitar acceso
            </a>
            {site.contact && (
              <a class="button" href={site.contact}>
                Contactar con el equipo ↗
              </a>
            )}
          </div>
          <div class="info-links">
            <a href={url('guias/')}>
              <strong>Guía de inicio</strong>
              <span aria-hidden="true">→</span>
            </a>
            <a href={url('guias/preguntas-frecuentes/')}>
              <strong>Preguntas frecuentes</strong>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </>
      )}
    </div>
  </div>
  <script>
    // En móvil el índice empieza colapsado.
    if (matchMedia('(max-width: 900px)').matches)
      document.querySelector('[data-info-toc] details')?.removeAttribute('open');
  </script>
</Base>
